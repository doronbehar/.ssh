AddKeysToAgent yes
SendEnv SSH_ORIGINAL_TERM SSH_TERM_NO_ICONS_FONT

# {{{1 Git hosts
Host github.com
  User git
  HostName github.com
  IdentityFile ~/.ssh/github
Host gitlab.com
  User git
  HostName gitlab.com
  IdentityFile ~/.ssh/gitlab
  IdentitiesOnly yes
Host gitlab.gnome.org
  User git
  HostName gitlab.gnome.org
  IdentityFile ~/.ssh/gitlab.gnome.org
  IdentitiesOnly yes
Host codeberg.org
  User git
  HostName codeberg.org
  IdentityFile ~/.ssh/codeberg
  IdentitiesOnly yes
Host bitbucket.org
  User git
  HostName bitbucket.org
  IdentityFile ~/.ssh/bitbucket
Host aur.archlinux.org
  IdentityFile ~/.ssh/aur
  User aur
Host aur4.archlinux.org
  IdentityFile ~/.ssh/aur
  User aur
Host sourceforge.net
  IdentityFile ~/.ssh/sourceforge
  User aur
Host review.jami.net
  IdentityFile ~/.ssh/review.jami.net
  User doronbehar
  Port 29420
Host git.balena-cloud.com
  IdentityFile ~/.ssh/balena
  User gh_doronbehar
Host gitlab.gnome.org
  IdentityFile ~/.ssh/gitlab.gnome.org
  User git
Host invent.kde.org
  IdentityFile ~/.ssh/invent.kde.org
  User git
Host darwin-build-box.nix-community.org
  User doronbehar
  HostName darwin-build-box.nix-community.org
  IdentityFile ~/.ssh/darwin-build-box.nix-community.org
  IdentitiesOnly yes
  # Overrides what's in /etc/ssh/ssh_config, see:
  # https://gitlab.com/doronbehar/nixos-configs/-/blob/master/builders.nix
  ControlPath none
Host build-box.nix-community.org
  User doronbehar
  HostName build-box.nix-community.org
  IdentityFile ~/.ssh/build-box.nix-community.org
  IdentitiesOnly yes
  ControlPath none
Host aarch64-build-box.nix-community.org
  User doronbehar
  HostName aarch64-build-box.nix-community.org
  IdentityFile ~/.ssh/build-box.nix-community.org
  IdentitiesOnly yes
  ControlPath none
Host ZENIX
  ProxyCommand ssh build-box.nix-community.org -- nc -U /home/doronbehar/.ssh-bridge-ZENIX.sock
  User doron
  IdentityFile ~/.ssh/ZENIX
  IdentitiesOnly yes
  # No need for `ControlPath none` since ZENIX is not configured as a remote
  # builder of office host.
Host office
  ProxyCommand ssh build-box.nix-community.org -- nc -U /home/doronbehar/.ssh-bridge-office.sock
  User doron
  IdentityFile ~/.ssh/office
  IdentitiesOnly yes
  # Overrides what's in /etc/ssh/ssh_config, see:
  # https://gitlab.com/doronbehar/nixos-configs/-/blob/master/builders.nix
  ControlPath none
Host jukebox
  User doron
  IdentitiesOnly yes
  IdentityFile ~/.ssh/jukebox
  HostName jukebox.local
  # host key changes all the time whenever I flush a new SD
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no
Host jukebox-vm
  User doron
  IdentitiesOnly yes
  IdentityFile ~/.ssh/jukebox
  HostName localhost
  Port 2222
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no
Host lab-fpga
  User root
  IdentitiesOnly yes
  IdentityFile ~/.ssh/lab-fpga
  HostName fpga.local
  # host key changes all the time whenever I flush a new SD
  UserKnownHostsFile /dev/null
  StrictHostKeyChecking no

